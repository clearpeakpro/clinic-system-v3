{
  "name": "clinic-system-v3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:bootstrap": "pnpm --filter @clinic/db db:bootstrap",
    "db:migrate": "pnpm --filter @clinic/db db:migrate",
    "db:seed": "pnpm --filter @clinic/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@12.15.0"
}
