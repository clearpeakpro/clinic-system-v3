{
  "name": "clinic-system-v3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "turbo run lint && pnpm check:rls-context",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:bootstrap": "pnpm --filter @clinic/db db:bootstrap",
    "db:migrate": "pnpm --filter @clinic/db db:migrate",
    "db:seed": "pnpm --filter @clinic/db db:seed && pnpm --filter @clinic/api seed:dev",
    "org:create": "pnpm --filter @clinic/api org:create",
    "audit:platform": "pnpm --filter @clinic/api audit:platform",
    "demo:reset": "docker compose up -d --wait && pnpm --filter @clinic/api demo:reset",
    "demo:aviso": "pnpm --filter @clinic/api demo:aviso",
    "check:rls-context": "node packages/db/scripts/check-rls-context.ts",
    "dev": "docker compose up -d --wait && pnpm db:bootstrap && pnpm db:migrate && turbo run dev",
    "test:e2e": "pnpm --filter @clinic/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@12.15.0"
}
