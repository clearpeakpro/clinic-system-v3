{
  "name": "@clinic/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "node --env-file-if-exists=../../.env scripts/bootstrap.ts",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "testcontainers": "^12.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
