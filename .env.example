# Solo para desarrollo local. Copiar a .env (que git ignora) y cambiar las contraseñas.
POSTGRES_PASSWORD=postgres-dev-only
CLINIC_MIGRATOR_PASSWORD=migrator-dev-only
CLINIC_APP_PASSWORD=app-dev-only

DATABASE_SUPERUSER_URL=postgres://postgres:postgres-dev-only@127.0.0.1:5432/clinic
DATABASE_MIGRATOR_URL=postgres://clinic_migrator:migrator-dev-only@127.0.0.1:5432/clinic
DATABASE_APP_URL=postgres://clinic_app:app-dev-only@127.0.0.1:5432/clinic

# API (apps/api). Solo desarrollo: cambiar los secretos en .env.
BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUDIT_HMAC_KEY=dev-only-hmac-change-me-0123456789abcdef
SMTP_URL=smtp://127.0.0.1:1025
PORT=3001
# Contraseña de los Propietarios ficticios de la semilla (pnpm db:seed). Solo desarrollo.
DEV_SEED_PASSWORD=Ficticia-dev-123
# Límite por cuenta de inicios de sesión fallidos (ADR 0023). Opcional.
# SIGN_IN_ACCOUNT_MAX_FAILURES=10
# SIGN_IN_ACCOUNT_WINDOW_SECONDS=900
# Límite por IP del inicio de sesión (toda la clínica comparte IP). Opcional.
# SIGN_IN_IP_MAX_ATTEMPTS=30
# SIGN_IN_IP_WINDOW_SECONDS=60
